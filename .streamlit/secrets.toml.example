# Copia questo file in  .streamlit/secrets.toml  e inserisci la tua chiave.
# secrets.toml e' in .gitignore e NON deve mai finire nel repository.
#
# La chiave serve SOLO alla pipeline offline (cartella pipeline/).
# L'app Streamlit non chiama EODHD a runtime: legge gli artefatti Parquet.
# Di conseguenza il deploy pubblico su Streamlit Cloud puo' funzionare
# senza chiave, e nessun visitatore consuma la tua quota API.

EODHD_API_KEY = "la-tua-chiave-eodhd"
